{
  "name": "motionpath",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "types": "src/types/motionpath.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run --config vitest.phase0.config.js",
    "test:phase0": "vitest run --config vitest.phase0.config.js",
    "test:phase1-contract": "vitest run --config vitest.phase1-contract.config.js",
    "test:watch": "vitest",
    "test:deterministic": "vitest run --config vitest.phase0.config.js --reporter=dot",
    "typecheck": "npm exec --yes --package=typescript@5.8.3 -- tsc --noEmit -p tsconfig.json",
    "pack:check": "npm pack --dry-run",
    "format": "prettier . --write",
    "format:check": "npm exec --yes --package=prettier@3.6.2 -- prettier --check .",
    "format:check:ci": "npm exec --yes --package=prettier@3.6.2 -- prettier --check package.json .github/workflows/ci.yml",
    "reorg:physical": "node scripts/physical-reorg.mjs",
    "benchmark:rig": "node performance/rig-graph-benchmark.mjs && node performance/downstream-index-benchmark.mjs",
    "benchmark:v5:baseline": "node performance/v5-baseline.mjs",
    "boundary:v5:pass2": "node scripts/v5-pass2-boundaries.mjs",
    "boundary:v5:pass2:strict": "node scripts/v5-pass2-boundaries.mjs --strict"
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "lenis": "^1.3.25",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "prettier": "3.6.2",
    "vitest": "^4.1.10"
  }
}
